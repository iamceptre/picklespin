# Normalize line endings across machines (repo stores LF; Windows checkout gets CRLF)
* text=auto

# Source and Unity YAML files are text
*.cs text
*.shader text
*.cginc text
*.hlsl text
*.meta text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.asmdef text
*.json text
*.md text
*.txt text
*.xml text

# Note: *.asset is deliberately not listed — most are YAML text, but
# LightingData/NavMesh/Terrain .assets are binary; text=auto detects each correctly.

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.tif binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.bank binary
*.dll binary
*.pdb binary
*.so binary
*.dylib binary
*.a binary
*.ttf binary
*.otf binary
*.unitypackage binary
Assets/Plugins/FMOD/**/*.bundle text eol=lf
Assets/Plugins/FMOD/**/Info.plist text eol=lf
